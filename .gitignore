# Julia coverage instrumentation (`--code-coverage=user`) drops `.cov` files
# next to each source it touches. Keep them out of the working tree.
*.cov

# Manifest files — tracked at the top of the worktree only if needed.
# Leave Project.toml tracked; ignore the per-user Manifest.toml.
/Manifest.toml

# Trim-built artifacts from bin/build_standalone.jl. The build is
# reproducible (~30s) and binaries are large (~8MB) — don't track them.
/bin/build/
# Stage-5 corpus run artefacts (registry snapshots, per-package diag
# dumps, parse-pass JSON, LLM triage). Reproducible from the scripts;
# don't track the outputs.
scripts/large_scale_test/data/
